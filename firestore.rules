rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isMember(hid) {
      return signedIn() && email() in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    match /households/{hid} {
      allow get: if signedIn() && (resource == null || isMember(hid));
      allow create: if signedIn() && request.resource.data.members == [email()] && request.resource.data.owner == email();
      allow update: if isMember(hid) && request.resource.data.owner == resource.data.owner
                    && resource.data.owner in request.resource.data.members;
      allow delete: if false;

      // Shared house plan: every member
      match /config/{doc} { allow read, write: if isMember(hid); }
      match /settings/{doc} { allow read, write: if isMember(hid); }
      match /months/{doc} { allow read, write: if isMember(hid); }

      // "My spending": only the person it belongs to
      match /people/{uid}/{rest=**} {
        allow read, write: if isMember(hid) && request.auth.uid == uid;
      }
    }
  }
}
